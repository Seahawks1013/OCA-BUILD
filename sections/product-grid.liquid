{%- comment -%}
  Products
  Product grid in the house style. Pull a whole collection, or hand-pick and
  order products with Product blocks — blocks win when any are present.
  Blocks: product.
{%- endcomment -%}

{%- liquid
  # Counted with an explicit loop rather than `| where:` — that filter is
  # unreliable against locally-defined section blocks.
  assign picked_count = 0
  for block in section.blocks
    if block.type == 'product'
      assign picked_count = picked_count | plus: 1
    endif
  endfor

  assign source_count = picked_count
  if picked_count == 0 and section.settings.collection != blank
    assign source_count = section.settings.collection.products_count
    if source_count > section.settings.max_products
      assign source_count = section.settings.max_products
    endif
  endif

  # Never lay out more columns than there are products
  assign grid_cols = section.settings.columns
  if source_count > 0 and source_count < grid_cols
    assign grid_cols = source_count
  endif

  # repeat() only accepts a literal integer, so the breakpoint caps are worked
  # out here rather than with min() inside the CSS.
  assign grid_cols_tablet = grid_cols
  if grid_cols_tablet > 3
    assign grid_cols_tablet = 3
  endif
  assign grid_cols_mobile = grid_cols
  if grid_cols_mobile > 2
    assign grid_cols_mobile = 2
  endif
-%}

<product-grid
  class="pg"
  id="ProductGrid-{{ section.id }}"
  style="
    --pg-bg: {{ section.settings.background_color }};
    --pg-ink: {{ section.settings.heading_color }};
    --pg-muted: {{ section.settings.body_color }};
    --pg-accent: {{ section.settings.accent_color }};
    --pg-line: {{ section.settings.line_color }};
    --pg-max: {{ section.settings.max_width }}px;
    --pg-radius: {{ section.settings.corner_radius }}px;
    --pg-h1: {{ section.settings.heading_size }}px;
    --pg-h1-mobile: {{ section.settings.heading_size_mobile }}px;
    --pg-cols: {{ grid_cols }};
    --pg-cols-tablet: {{ grid_cols_tablet }};
    --pg-cols-mobile: {{ grid_cols_mobile }};
    --pg-gap: {{ section.settings.grid_gap }}px;
    --pg-card-w: {{ section.settings.card_width }}px;
    --pg-ratio: {{ section.settings.image_ratio }};
    --pg-pad-top: {{ section.settings.padding_top }}px;
    --pg-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="pg__inner">

    {%- if section.settings.eyebrow != blank
        or section.settings.heading != blank
        or section.settings.body != blank
        or section.settings.view_all_label != blank -%}
      <header class="pg__head">
        <div class="pg__head-copy">
          {%- if section.settings.eyebrow != blank -%}
            <p class="pg__eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="pg__heading" data-reveal style="--d:60ms">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.body != blank -%}
            <div class="pg__lede" data-reveal style="--d:110ms">{{ section.settings.body }}</div>
          {%- endif -%}
        </div>

        {%- if section.settings.view_all_label != blank and section.settings.view_all_link != blank -%}
          <a class="pg__viewall" href="{{ section.settings.view_all_link }}" data-reveal style="--d:150ms">
            <span>{{ section.settings.view_all_label }}</span>
            <span class="pg__viewall-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </a>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- comment -%}
      Cards are built once here, then dropped into either the static grid or
      the auto-scrolling reel. The reel prints the same set twice so the loop
      has no visible seam; JS hides the second copy from screen readers.
      Everything inside this capture is balanced markup.
    {%- endcomment -%}
    {%- capture cards -%}
      {%- if picked_count > 0 -%}
        {%- assign i = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type != 'product' -%}{%- continue -%}{%- endif -%}
          {%- assign i = i | plus: 1 -%}
          {%- assign product = block.settings.product -%}
          {%- if product == blank -%}{%- continue -%}{%- endif -%}

          {%- liquid
            assign card_image = block.settings.image
            if card_image == blank
              assign card_image = product.featured_image
            endif
            assign card_title = block.settings.title_override
            if card_title == blank
              assign card_title = product.title
            endif
            assign card_badge = block.settings.badge
          -%}

          <li class="pg__item" data-reveal style="--d:{{ i | times: 70 }}ms" {{ block.shopify_attributes }}>
            <a class="pg__card" href="{{ product.url }}">
              <span class="pg__media">
                {%- if card_image != blank -%}
                  {{ card_image | image_url: width: 900 | image_tag:
                      widths: '260, 400, 600, 900',
                      sizes: '(min-width: 990px) 25vw, (min-width: 750px) 45vw, 90vw',
                      alt: card_title, loading: 'lazy', class: 'pg__img' }}
                {%- else -%}
                  <span class="pg__img-ph"></span>
                {%- endif -%}

                {%- liquid
                  assign show_badge = card_badge
                  unless product.available
                    assign show_badge = 'Sold out'
                  endunless
                  if show_badge == blank and product.compare_at_price > product.price
                    assign show_badge = 'Sale'
                  endif
                -%}
                {%- if show_badge != blank -%}
                  <span class="pg__badge{% unless product.available %} pg__badge--out{% endunless %}">{{ show_badge }}</span>
                {%- endif -%}
              </span>

              <span class="pg__meta">
                <span class="pg__title">{{ card_title }}</span>
                {%- if section.settings.show_price -%}
                  <span class="pg__price">
                    <span class="pg__price-now">{{ product.price | money }}</span>
                    {%- if product.compare_at_price > product.price -%}
                      <s class="pg__price-was">{{ product.compare_at_price | money }}</s>
                    {%- endif -%}
                  </span>
                {%- endif -%}
              </span>
            </a>
          </li>
        {%- endfor -%}
      {%- elsif section.settings.collection != blank -%}
        {%- assign i = 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.max_products -%}
          {%- assign i = i | plus: 1 -%}
          <li class="pg__item" data-reveal style="--d:{{ i | times: 70 }}ms">
            <a class="pg__card" href="{{ product.url }}">
              <span class="pg__media">
                {%- if product.featured_image != blank -%}
                  {{ product.featured_image | image_url: width: 900 | image_tag:
                      widths: '260, 400, 600, 900',
                      sizes: '(min-width: 990px) 25vw, (min-width: 750px) 45vw, 90vw',
                      alt: product.title, loading: 'lazy', class: 'pg__img' }}
                {%- else -%}
                  <span class="pg__img-ph"></span>
                {%- endif -%}

                {%- liquid
                  assign show_badge = ''
                  unless product.available
                    assign show_badge = 'Sold out'
                  endunless
                  if show_badge == blank and product.compare_at_price > product.price
                    assign show_badge = 'Sale'
                  endif
                -%}
                {%- if show_badge != blank -%}
                  <span class="pg__badge{% unless product.available %} pg__badge--out{% endunless %}">{{ show_badge }}</span>
                {%- endif -%}
              </span>

              <span class="pg__meta">
                <span class="pg__title">{{ product.title }}</span>
                {%- if section.settings.show_price -%}
                  <span class="pg__price">
                    <span class="pg__price-now">{{ product.price | money }}</span>
                    {%- if product.compare_at_price > product.price -%}
                      <s class="pg__price-was">{{ product.compare_at_price | money }}</s>
                    {%- endif -%}
                  </span>
                {%- endif -%}
              </span>
            </a>
          </li>
        {%- endfor -%}
      {%- endif -%}
    {%- endcapture -%}

    {%- if cards contains '<li' -%}
      {%- if section.settings.layout == 'scroll' -%}
        <div
          class="pg__reel"
          data-pg-reel
          data-pg-speed="{{ section.settings.scroll_speed }}"
          tabindex="0"
          role="region"
          aria-label="{{ section.settings.heading | default: 'Products' | escape }}"
        >
          <ul class="pg__track" data-pg-track role="list">{{ cards }}{{ cards }}</ul>
        </div>
      {%- else -%}
        <ul class="pg__grid" role="list">{{ cards }}</ul>
      {%- endif -%}
    {%- else -%}
      <p class="pg__empty">Pick a collection, or add Product blocks, to fill this grid.</p>
    {%- endif -%}

    {%- if section.settings.shop_label != blank and section.settings.shop_link != blank -%}
      <div class="pg__cta" data-reveal style="--d:120ms">
        <a class="pg__shop" href="{{ section.settings.shop_link }}">
          <span>{{ section.settings.shop_label }}</span>
          <span class="pg__shop-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
      </div>
    {%- endif -%}

  </div>

</product-grid>

<script>
  (function () {
    if (customElements.get('product-grid')) return;

    class ProductGrid extends HTMLElement {
      connectedCallback() {
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var targets = [].slice.call(this.querySelectorAll('[data-reveal]'));

        if (reduced || !('IntersectionObserver' in window)) {
          targets.forEach(function (el) { el.classList.add('is-in'); });
          return;
        }

        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          });
        }, { rootMargin: '0px 0px -12% 0px', threshold: 0.15 });

        targets.forEach(function (el) { io.observe(el); });

        this.initReel(reduced);
      }

      initReel(reduced) {
        var reel = this.querySelector('[data-pg-reel]');
        var track = this.querySelector('[data-pg-track]');
        if (!reel || !track) return;

        var self = this;
        var items = [].slice.call(track.children);
        var half = items.length / 2;

        // The second copy exists only to hide the seam — keep it out of the
        // accessibility tree and out of the tab order.
        items.forEach(function (el, k) {
          // cards in a horizontally scrolling strip would otherwise sit at
          // opacity 0 until scrolled past; show them all up front
          el.classList.add('is-in');
          if (k < half) return;
          el.setAttribute('aria-hidden', 'true');
          [].slice.call(el.querySelectorAll('a')).forEach(function (a) {
            a.setAttribute('tabindex', '-1');
          });
        });

        var loopWidth = function () { return track.scrollWidth / 2; };

        // ---- drag to scroll (mouse); touch scrolls natively ----
        var dragging = false, startX = 0, startLeft = 0, moved = false;

        reel.addEventListener('pointerdown', function (e) {
          if (e.pointerType === 'touch') return;
          dragging = true; moved = false;
          startX = e.clientX;
          startLeft = reel.scrollLeft;
        });

        reel.addEventListener('pointermove', function (e) {
          if (!dragging) return;
          var dx = e.clientX - startX;
          if (!moved && Math.abs(dx) > 3) {
            moved = true;
            reel.classList.add('is-dragging');
            // capture only once it is a real drag, otherwise the click gets
            // retargeted to the strip and no product link opens
            try { reel.setPointerCapture(e.pointerId); } catch (err) {}
          }
          if (moved) reel.scrollLeft = startLeft - dx;
        });

        var endDrag = function (e) {
          if (!dragging) return;
          dragging = false;
          if (e && e.pointerId !== undefined) {
            try { reel.releasePointerCapture(e.pointerId); } catch (err) {}
          }
          reel.classList.remove('is-dragging');
        };
        reel.addEventListener('pointerup', endDrag);
        reel.addEventListener('pointercancel', endDrag);
        window.addEventListener('pointerup', endDrag);

        // a drag that ends on a card must not also follow its link
        reel.addEventListener('click', function (e) {
          if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; }
        }, true);

        if (reduced) return;

        // ---- auto-scroll ----
        var speed = parseFloat(reel.dataset.pgSpeed) || 40;
        var paused = false, last = 0;
        // Chrome rounds scrollLeft to whole pixels, so reading it back each
        // frame and adding a sub-pixel step rounds up every time and runs fast.
        // Keep the true position here and only ever write it out.
        var pos = reel.scrollLeft;

        var pause = function () { paused = true; };
        var resume = function () { paused = false; };

        reel.addEventListener('pointerenter', pause);
        reel.addEventListener('pointerleave', resume);
        reel.addEventListener('focusin', pause);
        reel.addEventListener('focusout', resume);
        reel.addEventListener('pointerdown', pause);
        reel.addEventListener('touchstart', pause, { passive: true });
        document.addEventListener('visibilitychange', function () {
          if (document.hidden) pause(); else resume();
        });

        var tick = function (now) {
          self.raf = requestAnimationFrame(tick);
          if (!last) { last = now; return; }
          var dt = (now - last) / 1000;
          last = now;
          if (paused || dragging || dt > 0.5) return;

          // the visitor scrolled or dragged out from under us — adopt it
          if (Math.abs(reel.scrollLeft - pos) > 2) pos = reel.scrollLeft;

          pos += speed * dt;
          var w = loopWidth();
          if (w > 0 && pos >= w) pos -= w;
          reel.scrollLeft = pos;
        };
        this.raf = requestAnimationFrame(tick);
      }

      disconnectedCallback() {
        if (this.raf) cancelAnimationFrame(this.raf);
      }
    }

    customElements.define('product-grid', ProductGrid);
  })();
</script>

{% stylesheet %}
  .pg {
    display: block;
    background: var(--pg-bg, #f1f1ef);
    color: var(--pg-muted, #6b6b68);
    padding-block: var(--pg-pad-top, 80px) var(--pg-pad-bottom, 80px);
    font-feature-settings: 'kern' 1, 'liga' 1;
  }

  .pg__inner {
    max-inline-size: var(--pg-max, 1160px);
    margin-inline: auto;
    padding-inline: clamp(18px, 4vw, 40px);
  }

  [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) var(--d, 0ms),
                transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) var(--d, 0ms);
  }

  [data-reveal].is-in { opacity: 1; transform: none; }

  /* ---------- header ---------- */
  .pg__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-block-end: 2.4rem;
  }

  .pg__head-copy { flex: 1 1 420px; }

  .pg__eyebrow {
    margin: 0 0 0.9rem;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--pg-accent, #1242fd);
  }

  .pg__heading {
    margin: 0;
    font-family: var(--font-heading--family, inherit);
    font-size: min(var(--pg-h1, 60px), 8.4vw);
    font-weight: 900;
    line-height: 0.96;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    color: var(--pg-ink, #111);
    max-width: 18ch;
    text-wrap: balance;
    word-break: keep-all;
    overflow-wrap: normal;
  }

  .pg__lede {
    margin-block-start: 1.1rem;
    font-size: 15px;
    line-height: 1.6;
    max-width: 54ch;
  }

  .pg__lede > :first-child { margin-block-start: 0; }
  .pg__lede > :last-child { margin-block-end: 0; }

  .pg__viewall {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex: 0 0 auto;
    padding: 10px 12px 10px 20px;
    border: 1px solid var(--pg-line, #d9d9d4);
    border-radius: 999px;
    color: var(--pg-ink, #111);
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
    transition: background 0.28s ease, color 0.28s ease, border-color 0.28s ease, transform 0.28s ease;
  }

  .pg__viewall:hover {
    background: var(--pg-accent, #1242fd);
    border-color: var(--pg-accent, #1242fd);
    color: #fff;
    transform: translateY(-2px);
  }

  .pg__viewall-arrow {
    display: inline-grid;
    place-items: center;
    inline-size: 26px;
    block-size: 26px;
    border-radius: 50%;
    background: var(--pg-accent, #1242fd);
    color: #fff;
    transition: background 0.28s ease, color 0.28s ease;
  }

  .pg__viewall:hover .pg__viewall-arrow { background: #fff; color: var(--pg-accent, #1242fd); }
  .pg__viewall-arrow svg { inline-size: 14px; block-size: 14px; }

  .pg__viewall:focus-visible {
    outline: 2px solid var(--pg-accent, #1242fd);
    outline-offset: 3px;
  }

  /* ---------- grid ---------- */
  .pg__grid {
    display: grid;
    grid-template-columns: repeat(var(--pg-cols, 4), minmax(0, 1fr));
    gap: var(--pg-gap, 20px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ---------- auto-scrolling reel ---------- */
  .pg__reel {
    overflow-x: auto;
    overflow-y: hidden;
    /* deliberately no scroll-behavior:smooth — it would fight the per-frame
       scrollLeft writes and the reel would barely move */
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
  }

  .pg__reel::-webkit-scrollbar { display: none; }

  .pg__reel:focus-visible {
    outline: 2px solid var(--pg-accent, #1242fd);
    outline-offset: 4px;
    border-radius: var(--pg-radius, 14px);
  }

  .pg__reel.is-dragging { cursor: grabbing; }
  .pg__reel.is-dragging .pg__card { pointer-events: none; }

  .pg__track {
    display: flex;
    gap: var(--pg-gap, 20px);
    inline-size: max-content;
    margin: 0;
    padding: 0 0 4px;
    list-style: none;
  }

  .pg__track .pg__item { flex: 0 0 var(--pg-card-w, 260px); }

  /* ---------- shop-now button ---------- */
  .pg__cta {
    display: flex;
    justify-content: center;
    margin-block-start: clamp(28px, 3.6vw, 48px);
  }

  .pg__shop {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 14px 14px 14px 28px;
    border-radius: 999px;
    background: var(--pg-accent, #1242fd);
    color: #fff;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.28s ease;
    box-shadow: 0 12px 30px rgb(18 66 253 / 0.28);
  }

  .pg__shop:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 40px rgb(18 66 253 / 0.36);
  }

  .pg__shop-arrow {
    display: inline-grid;
    place-items: center;
    inline-size: 30px;
    block-size: 30px;
    border-radius: 50%;
    background: #fff;
    color: var(--pg-accent, #1242fd);
  }

  .pg__shop-arrow svg { inline-size: 16px; block-size: 16px; }

  .pg__shop:focus-visible {
    outline: 2px solid var(--pg-ink, #111);
    outline-offset: 3px;
  }

  .pg__card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    block-size: 100%;
    text-decoration: none;
    color: inherit;
  }

  .pg__media {
    position: relative;
    display: block;
    aspect-ratio: var(--pg-ratio, 1);
    border-radius: calc(var(--pg-radius, 14px) + 2px);
    overflow: hidden;
    background: var(--pg-line, #d9d9d4);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.08);
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.45s ease;
  }

  .pg__card:hover .pg__media {
    transform: translateY(-6px);
    box-shadow: 0 24px 48px rgb(0 0 0 / 0.18);
  }

  .pg__img,
  .pg__img-ph {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .pg__card:hover .pg__img { transform: scale(1.04); }

  .pg__img-ph { background: linear-gradient(135deg, #1b1b1b, #0d1540); }

  .pg__badge {
    position: absolute;
    inset-block-start: 12px;
    inset-inline-start: 12px;
    display: inline-flex;
    align-items: center;
    block-size: 24px;
    padding-inline: 11px;
    border-radius: 999px;
    background: var(--pg-accent, #1242fd);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .pg__badge--out { background: #6b6b68; }

  .pg__meta {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding-inline: 2px;
  }

  .pg__title {
    font-size: 15px;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.25;
    color: var(--pg-ink, #111);
  }

  .pg__card:hover .pg__title { color: var(--pg-accent, #1242fd); }

  .pg__price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 14px;
  }

  .pg__price-now { font-weight: 700; color: var(--pg-ink, #111); }
  .pg__price-was { opacity: 0.5; font-size: 13px; }

  .pg__card:focus-visible {
    outline: 2px solid var(--pg-accent, #1242fd);
    outline-offset: 4px;
    border-radius: calc(var(--pg-radius, 14px) + 4px);
  }

  .pg__empty {
    margin: 0;
    padding: 40px 0;
    font-size: 14px;
    opacity: 0.7;
  }

  /* ---------- motion off ---------- */
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity: 1; transform: none; transition: none; }
    .pg__media, .pg__img, .pg__viewall, .pg__shop { transition: none; }
  }

  /* ---------- tablet ---------- */
  @media screen and (max-width: 989px) {
    .pg__grid { grid-template-columns: repeat(var(--pg-cols-tablet, 3), minmax(0, 1fr)); }
  }

  /* ---------- mobile ---------- */
  @media screen and (max-width: 749px) {
    .pg { padding-block: calc(var(--pg-pad-top, 80px) * 0.7) calc(var(--pg-pad-bottom, 80px) * 0.7); }
    .pg__heading { font-size: var(--pg-h1-mobile, 38px); max-width: none; }
    .pg__grid { grid-template-columns: repeat(var(--pg-cols-mobile, 2), minmax(0, 1fr)); gap: 14px; }
    .pg__track { gap: 14px; }
    .pg__track .pg__item { flex-basis: calc(var(--pg-card-w, 260px) * 0.72); }
    .pg__viewall { inline-size: 100%; justify-content: space-between; }
    .pg__shop { inline-size: 100%; justify-content: space-between; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Products",
  "tag": "section",
  "class": "product-grid-wrapper section-wrapper",
  "max_blocks": 24,
  "settings": [
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line above",
      "default": "THE CATALOGUE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every preset we make."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Description",
      "default": "<p>Instant download, one-time payment, yours for good.</p>"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View-all button label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View-all button link",
      "info": "Both the label and the link must be filled in for the button to show."
    },
    {
      "type": "text",
      "id": "shop_label",
      "label": "Button under the products",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "shop_link",
      "label": "Button link",
      "info": "Both the label and the link must be filled in for the button to show."
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Ignored if you add Product blocks below — those take over, and let you set the order."
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Most products to show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8,
      "info": "Only applies when pulling from a collection."
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show prices",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "scroll", "label": "Auto-scrolling row" },
        { "value": "grid", "label": "Static grid" }
      ],
      "default": "scroll",
      "info": "The row drifts on its own and pauses whenever someone hovers, taps or focuses it. Visitors can also drag or swipe it."
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll speed",
      "min": 10,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 40,
      "info": "Pixels per second. Only applies to the auto-scrolling row."
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width",
      "min": 180,
      "max": 420,
      "step": 20,
      "unit": "px",
      "default": 260,
      "info": "Only applies to the auto-scrolling row."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Products per row",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "info": "Caps at 3 on tablet and 2 on mobile automatically."
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Gap between products",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "3 / 4", "label": "Tall" },
        { "value": "16 / 9", "label": "Wide" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content width",
      "min": 900,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1160
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Type & colour"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 28,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 22,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f1f1ef"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#1242fd"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Headings & titles",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text",
      "default": "#6b6b68"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Rules & image backdrop",
      "default": "#d9d9d4"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom artwork",
          "info": "Leave empty to use the product's own image."
        },
        {
          "type": "text",
          "id": "title_override",
          "label": "Custom title",
          "info": "Leave empty to use the product's own title."
        },
        {

{%- comment -%}
  Products
  Product grid in the house style. Pull a whole collection, or hand-pick and
  order products with Product blocks — blocks win when any are present.
  Blocks: product.
{%- endcomment -%}

{%- liquid
  # Counted with an explicit loop rather than `| where:` — that filter is
  # unreliable against locally-defined section blocks.
  assign picked_count = 0
  for block in section.blocks
    if block.type == 'product'
      assign picked_count = picked_count | plus: 1
    endif
  endfor

  assign source_count = picked_count
  if picked_count == 0 and section.settings.collection != blank
    assign source_count = section.settings.collection.products_count
    if source_count > section.settings.max_products
      assign source_count = section.settings.max_products
    endif
  endif

  # Never lay out more columns than there are products
  assign grid_cols = section.settings.columns
  if source_count > 0 and source_count < grid_cols
    assign grid_cols = source_count
  endif

  # repeat() only accepts a literal integer, so the breakpoint caps are worked
  # out here rather than with min() inside the CSS.
  assign grid_cols_tablet = grid_cols
  if grid_cols_tablet > 3
    assign grid_cols_tablet = 3
  endif
  assign grid_cols_mobile = grid_cols
  if grid_cols_mobile > 2
    assign grid_cols_mobile = 2
  endif
-%}

<product-grid
  class="pg"
  id="ProductGrid-{{ section.id }}"
  style="
    --pg-bg: {{ section.settings.background_color }};
    --pg-ink: {{ section.settings.heading_color }};
    --pg-muted: {{ section.settings.body_color }};
    --pg-accent: {{ section.settings.accent_color }};
    --pg-line: {{ section.settings.line_color }};
    --pg-max: {{ section.settings.max_width }}px;
    --pg-radius: {{ section.settings.corner_radius }}px;
    --pg-h1: {{ section.settings.heading_size }}px;
    --pg-h1-mobile: {{ section.settings.heading_size_mobile }}px;
    --pg-cols: {{ grid_cols }};
    --pg-cols-tablet: {{ grid_cols_tablet }};
    --pg-cols-mobile: {{ grid_cols_mobile }};
    --pg-gap: {{ section.settings.grid_gap }}px;
    --pg-ratio: {{ section.settings.image_ratio }};
    --pg-pad-top: {{ section.settings.padding_top }}px;
    --pg-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="pg__inner">

    {%- if section.settings.eyebrow != blank
        or section.settings.heading != blank
        or section.settings.body != blank
        or section.settings.view_all_label != blank -%}
      <header class="pg__head">
        <div class="pg__head-copy">
          {%- if section.settings.eyebrow != blank -%}
            <p class="pg__eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="pg__heading" data-reveal style="--d:60ms">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.body != blank -%}
            <div class="pg__lede" data-reveal style="--d:110ms">{{ section.settings.body }}</div>
          {%- endif -%}
        </div>

        {%- if section.settings.view_all_label != blank and section.settings.view_all_link != blank -%}
          <a class="pg__viewall" href="{{ section.settings.view_all_link }}" data-reveal style="--d:150ms">
            <span>{{ section.settings.view_all_label }}</span>
            <span class="pg__viewall-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </a>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- comment -%}
      Two paths: hand-picked Product blocks first, else the chosen collection.
      The card markup is kept identical between them.
    {%- endcomment -%}
    {%- if picked_count > 0 -%}
      <ul class="pg__grid" role="list">
        {%- assign i = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type != 'product' -%}{%- continue -%}{%- endif -%}
          {%- assign i = i | plus: 1 -%}
          {%- assign product = block.settings.product -%}
          {%- if product == blank -%}{%- continue -%}{%- endif -%}

          {%- liquid
            assign card_image = block.settings.image
            if card_image == blank
              assign card_image = product.featured_image
            endif
            assign card_title = block.settings.title_override
            if card_title == blank
              assign card_title = product.title
            endif
            assign card_badge = block.settings.badge
          -%}

          <li class="pg__item" data-reveal style="--d:{{ i | times: 70 }}ms" {{ block.shopify_attributes }}>
            <a class="pg__card" href="{{ product.url }}">
              <span class="pg__media">
                {%- if card_image != blank -%}
                  {{ card_image | image_url: width: 900 | image_tag:
                      widths: '260, 400, 600, 900',
                      sizes: '(min-width: 990px) 25vw, (min-width: 750px) 45vw, 90vw',
                      alt: card_title, loading: 'lazy', class: 'pg__img' }}
                {%- else -%}
                  <span class="pg__img-ph"></span>
                {%- endif -%}

                {%- liquid
                  assign show_badge = card_badge
                  unless product.available
                    assign show_badge = 'Sold out'
                  endunless
                  if show_badge == blank and product.compare_at_price > product.price
                    assign show_badge = 'Sale'
                  endif
                -%}
                {%- if show_badge != blank -%}
                  <span class="pg__badge{% unless product.available %} pg__badge--out{% endunless %}">{{ show_badge }}</span>
                {%- endif -%}
              </span>

              <span class="pg__meta">
                <span class="pg__title">{{ card_title }}</span>
                {%- if section.settings.show_price -%}
                  <span class="pg__price">
                    <span class="pg__price-now">{{ product.price | money }}</span>
                    {%- if product.compare_at_price > product.price -%}
                      <s class="pg__price-was">{{ product.compare_at_price | money }}</s>
                    {%- endif -%}
                  </span>
                {%- endif -%}
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>

    {%- elsif section.settings.collection != blank -%}
      <ul class="pg__grid" role="list">
        {%- assign i = 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.max_products -%}
          {%- assign i = i | plus: 1 -%}
          <li class="pg__item" data-reveal style="--d:{{ i | times: 70 }}ms">
            <a class="pg__card" href="{{ product.url }}">
              <span class="pg__media">
                {%- if product.featured_image != blank -%}
                  {{ product.featured_image | image_url: width: 900 | image_tag:
                      widths: '260, 400, 600, 900',
                      sizes: '(min-width: 990px) 25vw, (min-width: 750px) 45vw, 90vw',
                      alt: product.title, loading: 'lazy', class: 'pg__img' }}
                {%- else -%}
                  <span class="pg__img-ph"></span>
                {%- endif -%}

                {%- liquid
                  assign show_badge = ''
                  unless product.available
                    assign show_badge = 'Sold out'
                  endunless
                  if show_badge == blank and product.compare_at_price > product.price
                    assign show_badge = 'Sale'
                  endif
                -%}
                {%- if show_badge != blank -%}
                  <span class="pg__badge{% unless product.available %} pg__badge--out{% endunless %}">{{ show_badge }}</span>
                {%- endif -%}
              </span>

              <span class="pg__meta">
                <span class="pg__title">{{ product.title }}</span>
                {%- if section.settings.show_price -%}
                  <span class="pg__price">
                    <span class="pg__price-now">{{ product.price | money }}</span>
                    {%- if product.compare_at_price > product.price -%}
                      <s class="pg__price-was">{{ product.compare_at_price | money }}</s>
                    {%- endif -%}
                  </span>
                {%- endif -%}
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>

    {%- else -%}
      <p class="pg__empty">Pick a collection, or add Product blocks, to fill this grid.</p>
    {%- endif -%}

  </div>
</product-grid>

<script>
  (function () {
    if (customElements.get('product-grid')) return;

    class ProductGrid extends HTMLElement {
      connectedCallback() {
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var targets = [].slice.call(this.querySelectorAll('[data-reveal]'));

        if (reduced || !('IntersectionObserver' in window)) {
          targets.forEach(function (el) { el.classList.add('is-in'); });
          return;
        }

        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          });
        }, { rootMargin: '0px 0px -12% 0px', threshold: 0.15 });

        targets.forEach(function (el) { io.observe(el); });
      }
    }

    customElements.define('product-grid', ProductGrid);
  })();
</script>

{% stylesheet %}
  .pg {
    display: block;
    background: var(--pg-bg, #f1f1ef);
    color: var(--pg-muted, #6b6b68);
    padding-block: var(--pg-pad-top, 80px) var(--pg-pad-bottom, 80px);
    font-feature-settings: 'kern' 1, 'liga' 1;
  }

  .pg__inner {
    max-inline-size: var(--pg-max, 1160px);
    margin-inline: auto;
    padding-inline: clamp(18px, 4vw, 40px);
  }

  [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) var(--d, 0ms),
                transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) var(--d, 0ms);
  }

  [data-reveal].is-in { opacity: 1; transform: none; }

  /* ---------- header ---------- */
  .pg__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-block-end: 2.4rem;
  }

  .pg__head-copy { flex: 1 1 420px; }

  .pg__eyebrow {
    margin: 0 0 0.9rem;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--pg-accent, #1242fd);
  }

  .pg__heading {
    margin: 0;
    font-family: var(--font-heading--family, inherit);
    font-size: min(var(--pg-h1, 60px), 8.4vw);
    font-weight: 900;
    line-height: 0.96;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    color: var(--pg-ink, #111);
    max-width: 18ch;
    text-wrap: balance;
    word-break: keep-all;
    overflow-wrap: normal;
  }

  .pg__lede {
    margin-block-start: 1.1rem;
    font-size: 15px;
    line-height: 1.6;
    max-width: 54ch;
  }

  .pg__lede > :first-child { margin-block-start: 0; }
  .pg__lede > :last-child { margin-block-end: 0; }

  .pg__viewall {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex: 0 0 auto;
    padding: 10px 12px 10px 20px;
    border: 1px solid var(--pg-line, #d9d9d4);
    border-radius: 999px;
    color: var(--pg-ink, #111);
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
    transition: background 0.28s ease, color 0.28s ease, border-color 0.28s ease, transform 0.28s ease;
  }

  .pg__viewall:hover {
    background: var(--pg-accent, #1242fd);
    border-color: var(--pg-accent, #1242fd);
    color: #fff;
    transform: translateY(-2px);
  }

  .pg__viewall-arrow {
    display: inline-grid;
    place-items: center;
    inline-size: 26px;
    block-size: 26px;
    border-radius: 50%;
    background: var(--pg-accent, #1242fd);
    color: #fff;
    transition: background 0.28s ease, color 0.28s ease;
  }

  .pg__viewall:hover .pg__viewall-arrow { background: #fff; color: var(--pg-accent, #1242fd); }
  .pg__viewall-arrow svg { inline-size: 14px; block-size: 14px; }

  .pg__viewall:focus-visible {
    outline: 2px solid var(--pg-accent, #1242fd);
    outline-offset: 3px;
  }

  /* ---------- grid ---------- */
  .pg__grid {
    display: grid;
    grid-template-columns: repeat(var(--pg-cols, 4), minmax(0, 1fr));
    gap: var(--pg-gap, 20px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pg__card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    block-size: 100%;
    text-decoration: none;
    color: inherit;
  }

  .pg__media {
    position: relative;
    display: block;
    aspect-ratio: var(--pg-ratio, 1);
    border-radius: calc(var(--pg-radius, 14px) + 2px);
    overflow: hidden;
    background: var(--pg-line, #d9d9d4);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.08);
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.45s ease;
  }

  .pg__card:hover .pg__media {
    transform: translateY(-6px);
    box-shadow: 0 24px 48px rgb(0 0 0 / 0.18);
  }

  .pg__img,
  .pg__img-ph {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .pg__card:hover .pg__img { transform: scale(1.04); }

  .pg__img-ph { background: linear-gradient(135deg, #1b1b1b, #0d1540); }

  .pg__badge {
    position: absolute;
    inset-block-start: 12px;
    inset-inline-start: 12px;
    display: inline-flex;
    align-items: center;
    block-size: 24px;
    padding-inline: 11px;
    border-radius: 999px;
    background: var(--pg-accent, #1242fd);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .pg__badge--out { background: #6b6b68; }

  .pg__meta {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding-inline: 2px;
  }

  .pg__title {
    font-size: 15px;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.25;
    color: var(--pg-ink, #111);
  }

  .pg__card:hover .pg__title { color: var(--pg-accent, #1242fd); }

  .pg__price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 14px;
  }

  .pg__price-now { font-weight: 700; color: var(--pg-ink, #111); }
  .pg__price-was { opacity: 0.5; font-size: 13px; }

  .pg__card:focus-visible {
    outline: 2px solid var(--pg-accent, #1242fd);
    outline-offset: 4px;
    border-radius: calc(var(--pg-radius, 14px) + 4px);
  }

  .pg__empty {
    margin: 0;
    padding: 40px 0;
    font-size: 14px;
    opacity: 0.7;
  }

  /* ---------- motion off ---------- */
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity: 1; transform: none; transition: none; }
    .pg__media, .pg__img, .pg__viewall { transition: none; }
  }

  /* ---------- tablet ---------- */
  @media screen and (max-width: 989px) {
    .pg__grid { grid-template-columns: repeat(var(--pg-cols-tablet, 3), minmax(0, 1fr)); }
  }

  /* ---------- mobile ---------- */
  @media screen and (max-width: 749px) {
    .pg { padding-block: calc(var(--pg-pad-top, 80px) * 0.7) calc(var(--pg-pad-bottom, 80px) * 0.7); }
    .pg__heading { font-size: var(--pg-h1-mobile, 38px); max-width: none; }
    .pg__grid { grid-template-columns: repeat(var(--pg-cols-mobile, 2), minmax(0, 1fr)); gap: 14px; }
    .pg__viewall { inline-size: 100%; justify-content: space-between; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Products",
  "tag": "section",
  "class": "product-grid-wrapper section-wrapper",
  "max_blocks": 24,
  "settings": [
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line above",
      "default": "THE CATALOGUE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every preset we make."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Description",
      "default": "<p>Instant download, one-time payment, yours for good.</p>"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View-all button label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View-all button link",
      "info": "Both the label and the link must be filled in for the button to show."
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Ignored if you add Product blocks below — those take over, and let you set the order."
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Most products to show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8,
      "info": "Only applies when pulling from a collection."
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show prices",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Products per row",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "info": "Caps at 3 on tablet and 2 on mobile automatically."
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Gap between products",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "3 / 4", "label": "Tall" },
        { "value": "16 / 9", "label": "Wide" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content width",
      "min": 900,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1160
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Type & colour"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 28,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 22,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f1f1ef"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#1242fd"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Headings & titles",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text",
      "default": "#6b6b68"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Rules & image backdrop",
      "default": "#d9d9d4"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom artwork",
          "info": "Leave empty to use the product's own image."
        },
        {
          "type": "text",
          "id": "title_override",
          "label": "Custom title",
          "info": "Leave empty to use the product's own title."
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "info": "Small pill on the artwork, e.g. NEW. Sold-out and sale badges appear on their own."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Products",
      "category": "Products",
      "settings": {
        "eyebrow": "THE CATALOGUE",
        "heading": "Every preset we make.",
        "columns": 4
      }
    }
  ]
}
{% endschema %}
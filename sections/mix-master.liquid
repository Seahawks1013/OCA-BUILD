{%- comment -%}
  Mix & Master
  Five-part service page section: hero + trust stats, engineering credits carousel,
  pricing card, client-journey steps, closing statement.
  Blocks: stat / credit / photo / plan / step.
{%- endcomment -%}

{%- liquid
  # Counted with explicit loops rather than `| where:` — that filter is
  # unreliable against locally-defined section blocks.
  assign stat_count = 0
  assign credit_count = 0
  assign step_count = 0
  assign gallery_count = 0
  assign plan_count = 0
  for block in section.blocks
    case block.type
      when 'stat'
        assign stat_count = stat_count | plus: 1
      when 'credit'
        assign credit_count = credit_count | plus: 1
      when 'step'
        assign step_count = step_count | plus: 1
      when 'photo'
        assign gallery_count = gallery_count | plus: 1
      when 'plan'
        assign plan_count = plan_count | plus: 1
    endcase
  endfor
-%}

<mix-master
  class="mm"
  id="MixMaster-{{ section.id }}"
  data-reel-speed="{{ section.settings.reel_speed }}"
  style="
    --mm-bg: {{ section.settings.background_color }};
    --mm-ink: {{ section.settings.heading_color }};
    --mm-muted: {{ section.settings.body_color }};
    --mm-accent: {{ section.settings.accent_color }};
    --mm-line: {{ section.settings.line_color }};
    --mm-card: {{ section.settings.card_color }};
    --mm-card-ink: {{ section.settings.card_text_color }};
    --mm-max: {{ section.settings.max_width }}px;
    --mm-radius: {{ section.settings.corner_radius }}px;
    --mm-h1: {{ section.settings.headline_size }}px;
    --mm-h1-mobile: {{ section.settings.headline_size_mobile }}px;
    --mm-pad-top: {{ section.settings.padding_top }}px;
    --mm-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="mm__inner">

    {%- comment -%} ---------- 1. HERO + TRUST ---------- {%- endcomment -%}
    <header class="mm__hero">
      {%- if section.settings.hero_eyebrow != blank -%}
        <p class="mm__eyebrow" data-reveal>{{ section.settings.hero_eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.hero_headline != blank -%}
        <h2 class="mm__headline" data-reveal style="--d:60ms">{{ section.settings.hero_headline }}</h2>
      {%- endif -%}

      {%- if section.settings.hero_body != blank -%}
        <div class="mm__lede" data-reveal style="--d:120ms">{{ section.settings.hero_body }}</div>
      {%- endif -%}

      {%- if section.settings.instagram_url != blank -%}
        <a
          class="mm__ig"
          href="{{ section.settings.instagram_url }}"
          target="_blank"
          rel="noopener noreferrer"
          data-reveal
          style="--d:150ms"
        >
          <span class="mm__ig-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" focusable="false">
              <rect x="2.5" y="2.5" width="19" height="19" rx="5.4"/>
              <circle cx="12" cy="12" r="4.2"/>
              <circle cx="17.6" cy="6.4" r="1.1" fill="currentColor" stroke="none"/>
            </svg>
          </span>
          <span class="mm__ig-text">
            {{- section.settings.instagram_label | default: 'Follow on Instagram' -}}
          </span>
          <span class="mm__sr">(opens in a new tab)</span>
        </a>
      {%- endif -%}

      {%- if stat_count > 0 -%}
        <ul class="mm__stats" role="list">
          {%- assign si = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type != 'stat' -%}{%- continue -%}{%- endif -%}
            {%- assign si = si | plus: 1 -%}
            <li class="mm__stat" data-reveal style="--d:{{ si | times: 90 | plus: 160 }}ms" {{ block.shopify_attributes }}>
              <span class="mm__stat-value">
                <span
                  class="mm__stat-num"
                  data-count-to="{{ block.settings.value }}"
                  data-decimals="{{ block.settings.decimals }}"
                >0</span><span class="mm__stat-suffix">{{ block.settings.suffix }}</span>
              </span>
              <span class="mm__stat-label">{{ block.settings.label }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </header>

    {%- comment -%} ---------- 1b. PHOTO GALLERY ---------- {%- endcomment -%}
    {%- if gallery_count > 0 -%}
      <section class="mm__block mm__gallery-block">
        {%- if section.settings.gallery_headline != blank or section.settings.gallery_body != blank -%}
          <div class="mm__block-head" data-reveal>
            {%- if section.settings.gallery_headline != blank -%}
              <h3 class="mm__h3">{{ section.settings.gallery_headline }}</h3>
            {%- endif -%}
            {%- if section.settings.gallery_body != blank -%}
              <div class="mm__block-body">{{ section.settings.gallery_body }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <ul class="mm__gallery" role="list" style="--mm-gallery-cols: {{ section.settings.gallery_columns }};">
          {%- assign gi = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type != 'photo' -%}{%- continue -%}{%- endif -%}
            {%- assign gi = gi | plus: 1 -%}
            <li
              class="mm__photo{% if block.settings.wide %} mm__photo--wide{% endif %}"
              data-reveal
              style="--d:{{ gi | times: 70 }}ms; --mm-photo-ratio: {{ block.settings.ratio }};"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1400 | image_tag:
                    widths: '400, 700, 1000, 1400',
                    sizes: '(min-width: 750px) 40vw, 90vw',
                    alt: block.settings.caption,
                    loading: 'lazy', class: 'mm__photo-img' }}
              {%- else -%}
                <span class="mm__photo-ph"></span>
              {%- endif -%}
              {%- if block.settings.caption != blank -%}
                <span class="mm__photo-caption">{{ block.settings.caption }}</span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </section>
    {%- endif -%}

    {%- comment -%} ---------- 2. ENGINEERING CREDITS ---------- {%- endcomment -%}
    {%- if credit_count > 0 -%}
      <section class="mm__block mm__credits">
        <div class="mm__block-head" data-reveal>
          {%- if section.settings.credits_headline != blank -%}
            <h3 class="mm__h3">{{ section.settings.credits_headline }}</h3>
          {%- endif -%}
          {%- if section.settings.credits_body != blank -%}
            <div class="mm__block-body">{{ section.settings.credits_body }}</div>
          {%- endif -%}
        </div>

        {%- liquid
          assign autoscroll = section.settings.credits_autoscroll
          if autoscroll
            assign passes = 2
          else
            assign passes = 1
          endif
        -%}
        <div
          class="mm__reel-wrap mm__reel-wrap--{{ section.settings.credits_nav | default: 'below' }}"
          data-reveal
          style="--d:80ms"
        >
          <button
            class="mm__reel-arrow mm__reel-arrow--prev"
            type="button"
            data-mm-reel-prev
            aria-label="Previous credits"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
              <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <div
            class="mm__reel"
            data-mm-reel
            {% if autoscroll %}data-mm-autoscroll="true"{% endif %}
            tabindex="0"
            role="region"
            aria-label="{{ section.settings.credits_headline | default: 'Engineering credits' | escape }}"
          >
            <div class="mm__reel-track" data-mm-reel-track>
            {%- for pass in (1..passes) -%}
              {%- for block in section.blocks -%}
                {%- if block.type != 'credit' -%}{%- continue -%}{%- endif -%}
                <figure class="mm__cover" {% if pass == 2 %}aria-hidden="true"{% endif %} {{ block.shopify_attributes }}>
                  <span class="mm__cover-art">
                    {%- if block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 600 | image_tag:
                          widths: '200, 300, 450, 600', sizes: '200px',
                          alt: block.settings.title, loading: 'lazy', class: 'mm__cover-img' }}
                    {%- else -%}
                      <span class="mm__cover-ph"></span>
                    {%- endif -%}
                    {%- if block.settings.streams != blank -%}
                      <span class="mm__cover-streams">
                        <span class="mm__cover-streams-num">{{ block.settings.streams }}</span>
                        {%- if section.settings.streams_label != blank -%}
                          <span class="mm__cover-streams-label">{{ section.settings.streams_label }}</span>
                        {%- endif -%}
                      </span>
                    {%- endif -%}
                  </span>
                  {%- if block.settings.title != blank -%}
                    <figcaption class="mm__cover-title">{{ block.settings.title }}</figcaption>
                  {%- endif -%}
                </figure>
              {%- endfor -%}
            {%- endfor -%}
            </div>
          </div>

          <button
            class="mm__reel-arrow mm__reel-arrow--next"
            type="button"
            data-mm-reel-next
            aria-label="Next credits"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
              <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </section>
    {%- endif -%}

    {%- comment -%} ---------- 2b. SPOTIFY PLAYLIST ---------- {%- endcomment -%}
    {%- liquid
      # Accepts any Spotify share link, with or without the ?si= tracking tail,
      # and the intl-xx/ prefix Spotify adds for some regions. The last path
      # segment is the id, the one before it the kind of thing it points at.
      assign sp_id = ''
      assign sp_kind = 'playlist'
      assign sp_raw = section.settings.spotify_url | strip

      if sp_raw != blank
        assign sp_clean = sp_raw | split: '?' | first
        assign sp_clean = sp_clean | replace: 'spotify:', '' | replace: ':', '/'
        assign sp_parts = sp_clean | split: '/'
        assign sp_size = sp_parts.size

        if sp_size > 1
          assign sp_id = sp_parts | last
          assign sp_kind_index = sp_size | minus: 2
          assign sp_maybe_kind = sp_parts[sp_kind_index]
          assign sp_allowed = 'playlist,album,track,artist,show,episode' | split: ','
          if sp_allowed contains sp_maybe_kind
            assign sp_kind = sp_maybe_kind
          endif
        endif
      endif
    -%}

    {%- if sp_id != blank -%}
      <section class="mm__block mm__spotify-block">
        {%- if section.settings.spotify_headline != blank or section.settings.spotify_body != blank -%}
          <div class="mm__block-head" data-reveal>
            {%- if section.settings.spotify_headline != blank -%}
              <h3 class="mm__h3">{{ section.settings.spotify_headline }}</h3>
            {%- endif -%}
            {%- if section.settings.spotify_body != blank -%}
              <div class="mm__block-body">{{ section.settings.spotify_body }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="mm__spotify" data-reveal style="--d:80ms; --mm-spotify-h: {{ section.settings.spotify_height }}px;">
          <iframe
            class="mm__spotify-frame"
            src="https://open.spotify.com/embed/{{ sp_kind }}/{{ sp_id }}?utm_source=generator&amp;theme={{ section.settings.spotify_theme }}"
            title="{{ section.settings.spotify_headline | default: 'Spotify playlist' | escape }}"
            height="{{ section.settings.spotify_height }}"
            frameborder="0"
            loading="lazy"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </section>
    {%- endif -%}

    {%- comment -%} ---------- 3. PRICING TIERS ---------- {%- endcomment -%}
    {%- if plan_count > 0 -%}
      <section class="mm__block">
        {%- if section.settings.plans_headline != blank or section.settings.plans_body != blank -%}
          <div class="mm__block-head" data-reveal>
            {%- if section.settings.plans_headline != blank -%}
              <h3 class="mm__h3">{{ section.settings.plans_headline }}</h3>
            {%- endif -%}
            {%- if section.settings.plans_body != blank -%}
              <div class="mm__block-body">{{ section.settings.plans_body }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- liquid
          assign any_badge = false
          for block in section.blocks
            if block.type == 'plan' and block.settings.badge != blank
              assign any_badge = true
            endif
          endfor
        -%}
        <div class="mm__plans">
          {%- assign pl = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type != 'plan' -%}{%- continue -%}{%- endif -%}
            {%- assign pl = pl | plus: 1 -%}
            <article
              class="mm__card{% if block.settings.featured %} mm__card--featured{% endif %}"
              data-reveal
              style="--d:{{ pl | times: 90 }}ms"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.badge != blank -%}
                <span class="mm__badge">{{ block.settings.badge }}</span>
              {%- elsif any_badge -%}
                {%- comment -%} keeps headings aligned across cards {%- endcomment -%}
                <span class="mm__badge mm__badge--ghost" aria-hidden="true"></span>
              {%- endif -%}

              <div class="mm__card-top">
                <div>
                  {%- if block.settings.kicker != blank -%}
                    <p class="mm__card-kicker">{{ block.settings.kicker }}</p>
                  {%- endif -%}
                  {%- if block.settings.name != blank -%}
                    <h4 class="mm__card-title">{{ block.settings.name }}</h4>
                  {%- endif -%}
                </div>

                {%- if block.settings.price != blank -%}
                  <p class="mm__price">
                    <span class="mm__price-value">{{ block.settings.price }}</span>
                    {%- if block.settings.price_note != blank -%}
                      <span class="mm__price-note">{{ block.settings.price_note }}</span>
                    {%- endif -%}
                  </p>
                {%- endif -%}
              </div>

              {%- if block.settings.description != blank -%}
                <div class="mm__card-body">{{ block.settings.description }}</div>
              {%- endif -%}

              {%- if block.settings.features != blank -%}
                {%- comment -%} one deliverable per line {%- endcomment -%}
                {%- assign feature_lines = block.settings.features | newline_to_br | split: '<br />' -%}
                <ul class="mm__deliverables" role="list">
                  {%- for line in feature_lines -%}
                    {%- assign clean = line | strip -%}
                    {%- if clean != blank -%}
                      <li class="mm__deliverable">
                        <span class="mm__tick" aria-hidden="true">
                          <svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </span>
                        {{ clean }}
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}

              <div class="mm__actions">
                {%- if block.settings.primary_label != blank -%}
                  <a class="mm__btn mm__btn--primary" href="{{ block.settings.primary_link | default: '#' }}">
                    <span>{{ block.settings.primary_label }}</span>
                    <span class="mm__btn-arrow" aria-hidden="true">
                      <svg viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                  </a>
                {%- endif -%}
                {%- if block.settings.secondary_label != blank -%}
                  <a class="mm__btn mm__btn--ghost" href="{{ block.settings.secondary_link | default: '#' }}">
                    {{ block.settings.secondary_label }}
                  </a>
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}

    {%- comment -%} ---------- 4. CLIENT JOURNEY ---------- {%- endcomment -%}
    {%- if step_count > 0 -%}
      <section class="mm__block">
        <div class="mm__block-head" data-reveal>
          {%- if section.settings.process_headline != blank -%}
            <h3 class="mm__h3">{{ section.settings.process_headline }}</h3>
          {%- endif -%}
          {%- if section.settings.process_body != blank -%}
            <div class="mm__block-body">{{ section.settings.process_body }}</div>
          {%- endif -%}
        </div>

        <ol class="mm__steps" role="list">
          {%- assign pi = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type != 'step' -%}{%- continue -%}{%- endif -%}
            {%- assign pi = pi | plus: 1 -%}
            <li class="mm__step" data-reveal style="--d:{{ pi | times: 90 }}ms" {{ block.shopify_attributes }}>
              <span class="mm__step-num">{{ block.settings.number | default: pi }}</span>
              {%- if block.settings.title != blank -%}
                <h4 class="mm__step-title">{{ block.settings.title }}</h4>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="mm__step-text">{{ block.settings.text }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ol>
      </section>
    {%- endif -%}

    {%- comment -%} ---------- 5. CLOSING ---------- {%- endcomment -%}
    {%- if section.settings.closing_headline != blank or section.settings.closing_body != blank -%}
      <section class="mm__closing" data-reveal>
        {%- if section.settings.closing_headline != blank -%}
          <h3 class="mm__closing-headline">{{ section.settings.closing_headline }}</h3>
        {%- endif -%}
        {%- if section.settings.closing_body != blank -%}
          <div class="mm__closing-body">{{ section.settings.closing_body }}</div>
        {%- endif -%}
      </section>
    {%- endif -%}

  </div>
</mix-master>

<script>
  (function () {
    if (customElements.get('mix-master')) return;

    class MixMaster extends HTMLElement {
      connectedCallback() {
        if (this.dataset.ready === '1') return;
        this.dataset.ready = '1';

        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var self = this;

        // ---- reveal on scroll -------------------------------------------------
        var targets = this.querySelectorAll('[data-reveal]');
        if (reduced || !('IntersectionObserver' in window)) {
          targets.forEach(function (el) { el.classList.add('is-in'); });
        } else {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
              if (entry.target.classList.contains('mm__stat')) self.countUp(entry.target);
            });
          }, { rootMargin: '0px 0px -12% 0px', threshold: 0.15 });
          targets.forEach(function (el) { io.observe(el); });
        }

        // ---- credits carousel -------------------------------------------------
        this.initReel(reduced);
      }

      initReel(reduced) {
        var reel = this.querySelector('[data-mm-reel]');
        var track = this.querySelector('[data-mm-reel-track]');
        if (!reel || !track) return;

        var self = this;
        var prev = this.querySelector('[data-mm-reel-prev]');
        var next = this.querySelector('[data-mm-reel-next]');
        var looping = reel.dataset.mmAutoscroll === 'true' && !reduced;
        var speed = parseFloat(this.dataset.reelSpeed) || 40;

        // width of one cover + the flex gap, so a click advances by whole cards
        var stepSize = function () {
          var card = track.querySelector('.mm__cover');
          if (!card) return 220;
          var gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 0;
          return card.getBoundingClientRect().width + gap;
        };

        // how far you can scroll; when looping, the list is duplicated so the
        // meaningful range is only the first copy
        var maxScroll = function () {
          return looping
            ? track.scrollWidth / 2
            : Math.max(0, reel.scrollWidth - reel.clientWidth);
        };

        var syncArrows = function () {
          if (looping || !prev || !next) return;
          var max = maxScroll();
          prev.disabled = reel.scrollLeft <= 1;
          next.disabled = reel.scrollLeft >= max - 1;
          // nothing to scroll at all — hide rather than show two dead buttons
          var idle = max <= 1;
          prev.hidden = idle;
          next.hidden = idle;
        };

        var page = function (dir) {
          var perView = Math.max(1, Math.floor(reel.clientWidth / stepSize()));
          reel.scrollBy({ left: dir * stepSize() * perView, behavior: 'smooth' });
        };

        if (prev) prev.addEventListener('click', function () { page(-1); });
        if (next) next.addEventListener('click', function () { page(1); });

        // ---- drag to scroll (mouse); touch already scrolls natively ----------
        var dragging = false, startX = 0, startLeft = 0, moved = 0;

        reel.addEventListener('pointerdown', function (e) {
          if (e.pointerType === 'touch') return;
          dragging = true; moved = 0;
          startX = e.clientX;
          startLeft = reel.scrollLeft;
          reel.classList.add('is-dragging');
        });

        reel.addEventListener('pointermove', function (e) {
          if (!dragging) return;
          var dx = e.clientX - startX;
          if (Math.abs(dx) > 3) moved = 1;
          reel.scrollLeft = startLeft - dx;
        });

        var endDrag = function () {
          if (!dragging) return;
          dragging = false;
          reel.classList.remove('is-dragging');
        };
        reel.addEventListener('pointerup', endDrag);
        reel.addEventListener('pointercancel', endDrag);
        reel.addEventListener('pointerleave', endDrag);
        // a drag that ended on a cover shouldn't also fire its click
        reel.addEventListener('click', function (e) {
          if (moved) { e.preventDefault(); e.stopPropagation(); moved = 0; }
        }, true);

        // ---- keyboard --------------------------------------------------------
        reel.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowLeft') { page(-1); e.preventDefault(); }
          if (e.key === 'ArrowRight') { page(1); e.preventDefault(); }
        });

        // ---- optional auto-advance ------------------------------------------
        if (looping) {
          // snap points would yank the covers back between frames
          reel.style.scrollSnapType = 'none';
          var paused = false, last = 0;
          var pause = function () { paused = true; };
          var resume = function () { paused = false; };

          reel.addEventListener('pointerenter', pause);
          reel.addEventListener('pointerleave', resume);
          reel.addEventListener('focusin', pause);
          reel.addEventListener('focusout', resume);
          reel.addEventListener('pointerdown', pause);
          document.addEventListener('visibilitychange', function () {
            if (document.hidden) pause(); else resume();
          });

          // Chrome rounds scrollLeft to whole pixels. Reading it back each
          // frame and adding a sub-pixel delta rounds UP every time, which
          // runs the reel ~50% fast. Keep the true position as a float here
          // and only ever write it out.
          var pos = reel.scrollLeft;

          var tick = function (now) {
            self.raf = requestAnimationFrame(tick);
            if (!last) { last = now; return; }
            var dt = (now - last) / 1000;
            last = now;
            if (paused || dragging || dt > 0.5) return;

            // user scrolled or dragged out from under us — adopt their position
            if (Math.abs(reel.scrollLeft - pos) > 2) pos = reel.scrollLeft;

            pos += speed * dt;
            // seamless wrap: the second copy is pixel-identical to the first
            var half = maxScroll();
            if (half > 0 && pos >= half) pos -= half;
            reel.scrollLeft = pos;
          };
          this.raf = requestAnimationFrame(tick);
        }

        reel.addEventListener('scroll', syncArrows, { passive: true });
        if ('ResizeObserver' in window) {
          this.ro = new ResizeObserver(syncArrows);
          this.ro.observe(reel);
        }
        syncArrows();
      }

      disconnectedCallback() {
        if (this.ro) this.ro.disconnect();
        if (this.raf) cancelAnimationFrame(this.raf);
      }

      countUp(statEl) {
        var num = statEl.querySelector('[data-count-to]');
        if (!num || num.dataset.done === '1') return;
        num.dataset.done = '1';

        var target = parseFloat(num.dataset.countTo);
        if (!isFinite(target)) { num.textContent = num.dataset.countTo; return; }
        var dp = parseInt(num.dataset.decimals, 10) || 0;
        var dur = 1100;
        var start = null;

        function frame(ts) {
          if (start === null) start = ts;
          var p = Math.min(1, (ts - start) / dur);
          // ease-out so it settles rather than stopping dead
          var eased = 1 - Math.pow(1 - p, 3);
          num.textContent = (target * eased).toFixed(dp);
          if (p < 1) requestAnimationFrame(frame);
          else num.textContent = target.toFixed(dp);
        }
        requestAnimationFrame(frame);
      }
    }

    customElements.define('mix-master', MixMaster);
  })();
</script>

{% stylesheet %}
  .mm {
    display: block;
    background: var(--mm-bg, #f1f1ef);
    color: var(--mm-muted, #6b6b68);
    padding-block: var(--mm-pad-top, 96px) var(--mm-pad-bottom, 96px);
    padding-inline: var(--page-margin, 24px);
  }

  .mm__inner {
    max-width: var(--mm-max, 1160px);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: clamp(56px, 7vw, 104px);
  }

  /* ---------- reveal ---------- */
  [data-reveal] {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) var(--d, 0ms),
      transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) var(--d, 0ms);
  }

  [data-reveal].is-in { opacity: 1; transform: none; }

  /* ---------- 1. hero ---------- */
  .mm__eyebrow {
    margin: 0 0 1rem;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--mm-accent, #1242fd);
  }

  .mm__headline {
    font-family: var(--font-heading--family, inherit);
    font-size: min(var(--mm-h1, 84px), 8.2vw);
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: var(--mm-ink, #111);
    margin: 0;
    max-width: 16ch;
    overflow-wrap: normal;
  }

  .mm__lede {
    margin-block-start: 1.6rem;
    font-size: clamp(15px, 1.35vw, 18px);
    line-height: 1.6;
    max-width: 60ch;
  }

  .mm__lede > :first-child { margin-block-start: 0; }
  .mm__lede > :last-child { margin-block-end: 0; }

  /* screen-reader-only, scoped so it can't collide with the theme's helper */
  .mm__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .mm__ig {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-block-start: 1.6rem;
    padding: 11px 20px 11px 15px;
    border: 1px solid var(--mm-line, #d9d9d4);
    border-radius: 999px;
    color: var(--mm-ink, #111);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: background 0.3s ease, border-color 0.3s ease, color 0.3s ease, transform 0.3s ease;
  }

  .mm__ig-icon {
    display: inline-flex;
    color: var(--mm-accent, #1242fd);
    transition: color 0.3s ease;
  }

  .mm__ig:hover {
    background: var(--mm-accent, #1242fd);
    border-color: var(--mm-accent, #1242fd);
    color: #fff;
    transform: translateY(-2px);
  }

  .mm__ig:hover .mm__ig-icon { color: #fff; }

  .mm__ig:focus-visible {
    outline: 2px solid var(--mm-accent, #1242fd);
    outline-offset: 3px;
  }

  .mm__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 1px;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
    background: var(--mm-line, #d9d9d4);
    border-block: 1px solid var(--mm-line, #d9d9d4);
  }

  .mm__stat {
    background: var(--mm-bg, #f1f1ef);
    padding: 26px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .mm__stat-value {
    font-family: var(--font-heading--family, inherit);
    font-size: clamp(34px, 4vw, 52px);
    font-weight: 900;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--mm-ink, #111);
    font-variant-numeric: tabular-nums;
  }

  .mm__stat-suffix { color: var(--mm-accent, #1242fd); }

  .mm__stat-label {
    font-size: 13px;
    line-height: 1.45;
    max-width: 24ch;
  }

  /* ---------- shared block heads ---------- */
  .mm__block-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-block-end: 2rem;
  }

  .mm__h3 {
    font-family: var(--font-heading--family, inherit);
    font-size: clamp(26px, 3.4vw, 44px);
    font-weight: 900;
    letter-spacing: -0.035em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--mm-ink, #111);
    margin: 0;
  }

  .mm__block-body {
    font-size: 15px;
    line-height: 1.6;
    max-width: 46ch;
  }

  .mm__block-body > :first-child { margin-block-start: 0; }
  .mm__block-body > :last-child { margin-block-end: 0; }

  /* ---------- 2. credits carousel ---------- */
  .mm__reel-wrap {
    position: relative;
  }

  /* arrows flanking the covers */
  .mm__reel-wrap--sides {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* arrows centred underneath the covers — DOM order stays prev / reel / next
     for screen readers, grid placement moves them visually */
  .mm__reel-wrap--below {
    display: grid;
    /* 1fr gutters either side keep the pair centred under the full-width reel */
    grid-template-columns: 1fr auto auto 1fr;
    column-gap: 10px;
    row-gap: 16px;
  }

  .mm__reel-wrap--below .mm__reel {
    grid-column: 1 / -1;
    grid-row: 1;
  }

  .mm__reel-wrap--below .mm__reel-arrow--prev { grid-column: 2; grid-row: 2; }
  .mm__reel-wrap--below .mm__reel-arrow--next { grid-column: 3; grid-row: 2; }

  .mm__reel {
    flex: 1 1 auto;
    min-inline-size: 0;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x proximity;
    /* deliberately NOT scroll-behavior:smooth — that would fight the
       per-frame scrollLeft writes of auto-scroll. The arrows pass
       behavior:'smooth' explicitly instead. */
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    /* fade the ends so covers slide in and out rather than getting chopped */
    mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
  }

  .mm__reel::-webkit-scrollbar { display: none; }

  .mm__reel:focus-visible {
    outline: 2px solid var(--mm-accent, #1242fd);
    outline-offset: 4px;
    border-radius: var(--mm-radius, 14px);
  }

  /* snapping mid-drag fights the cursor */
  .mm__reel.is-dragging {
    scroll-snap-type: none;
    cursor: grabbing;
  }

  .mm__reel.is-dragging .mm__cover { pointer-events: none; }

  .mm__reel-track {
    display: flex;
    gap: 18px;
    width: max-content;
    padding-block-end: 4px;
  }

  .mm__reel-arrow {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 40px;
    block-size: 40px;
    padding: 0;
    border: 1px solid var(--mm-line, #d9d9d4);
    border-radius: 999px;
    background: transparent;
    color: var(--mm-ink, #111);
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease, opacity 0.25s ease;
  }

  .mm__reel-arrow:hover:not(:disabled) {
    background: var(--mm-accent, #1242fd);
    border-color: var(--mm-accent, #1242fd);
    color: #fff;
  }

  .mm__reel-arrow:disabled {
    opacity: 0.28;
    cursor: default;
  }

  .mm__cover {
    flex: 0 0 auto;
    inline-size: 200px;
    margin: 0;
    scroll-snap-align: start;
  }

  .mm__cover-art {
    position: relative;
    display: block;
    inline-size: 200px;
    block-size: 200px;
    border-radius: var(--mm-radius, 14px);
    overflow: hidden;
    background: var(--mm-line, #d9d9d4);
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.45s ease;
  }

  .mm__cover:hover .mm__cover-art {
    transform: translateY(-6px) scale(1.02);
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.2);
  }

  .mm__cover-img,
  .mm__cover-ph {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    display: block;
  }

  .mm__cover-ph { background: linear-gradient(135deg, #1b1b1b, #0d1540); }

  .mm__cover-streams {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    padding: 12px;
    text-align: center;
    color: #fff;
    background: linear-gradient(180deg, rgb(6 10 40 / 0.55), rgb(6 10 40 / 0.85));
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .mm__cover:hover .mm__cover-streams,
  .mm__cover:focus-within .mm__cover-streams { opacity: 1; }

  .mm__cover-streams-num {
    font-family: var(--font-heading--family, inherit);
    font-size: 26px;
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .mm__cover-streams-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .mm__cover-title {
    margin-block-start: 12px;
    font-size: 13px;
    font-weight: 700;
    color: var(--mm-ink, #111);
    line-height: 1.3;
  }

  /* ---------- 2b. spotify embed ---------- */
  .mm__spotify {
    border-radius: calc(var(--mm-radius, 14px) + 4px);
    overflow: hidden;
    background: var(--mm-card, #0d1231);
    box-shadow: 0 18px 44px rgb(0 0 0 / 0.14);
    line-height: 0;
  }

  .mm__spotify-frame {
    display: block;
    inline-size: 100%;
    block-size: var(--mm-spotify-h, 380px);
    border: 0;
  }

  /* ---------- 1b. photo gallery ---------- */
  .mm__gallery {
    display: grid;
    grid-template-columns: repeat(var(--mm-gallery-cols, 3), minmax(0, 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mm__photo {
    position: relative;
    margin: 0;
    border-radius: var(--mm-radius, 14px);
    overflow: hidden;
    background: var(--mm-line, #d9d9d4);
    aspect-ratio: var(--mm-photo-ratio, 1);
  }

  .mm__photo--wide { grid-column: span 2; }

  .mm__photo-img,
  .mm__photo-ph {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.65s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .mm__photo-ph { background: linear-gradient(135deg, #1b1b1b, #0d1540); }
  .mm__photo:hover .mm__photo-img { transform: scale(1.05); }

  .mm__photo-caption {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    padding: 26px 16px 14px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #fff;
    background: linear-gradient(180deg, rgb(6 10 40 / 0), rgb(6 10 40 / 0.75));
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .mm__photo:hover .mm__photo-caption { opacity: 1; transform: none; }

  /* ---------- 3. pricing tiers ---------- */
  .mm__plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 18px;
    align-items: stretch;
  }

  /* Card type sizes off the CARD's width, not the viewport's, so a third
     plan (narrower columns) shrinks the headings instead of wrapping
     "MIX & MASTER PRO" onto three lines. */
  @supports (container-type: inline-size) {
    .mm__card { container-type: inline-size; }
    .mm__card .mm__card-title { font-size: clamp(24px, 11cqi, 46px); }
    .mm__card .mm__price-value { font-size: clamp(34px, 17cqi, 68px); }
    .mm__card { padding: clamp(24px, 7cqi, 44px); }
  }

  .mm__badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    block-size: 26px;
    padding: 0 13px;
    border-radius: 999px;
    background: var(--mm-accent, #1242fd);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .mm__badge--ghost {
    background: transparent;
    padding: 0;
  }

  .mm__card--featured {
    outline: 2px solid var(--mm-accent, #1242fd);
    outline-offset: 3px;
  }


  .mm__card {
    background: var(--mm-card, #0d1231);
    color: var(--mm-card-ink, #fff);
    border-radius: calc(var(--mm-radius, 14px) + 8px);
    padding: clamp(26px, 3.4vw, 44px);
    display: flex;
    flex-direction: column;
    gap: 22px;
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.18);
    block-size: 100%;
  }

  .mm__card .mm__actions { margin-block-start: auto; }

  .mm__card-top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
  }

  .mm__card-kicker {
    margin: 0 0 0.6rem;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    opacity: 0.62;
  }

  .mm__card-title {
    font-family: var(--font-heading--family, inherit);
    font-size: clamp(28px, 3.6vw, 46px);
    font-weight: 900;
    letter-spacing: -0.035em;
    line-height: 1;
    text-transform: uppercase;
    margin: 0;
  }

  .mm__card-body {
    margin-block-start: 1rem;
    font-size: 15px;
    line-height: 1.6;
    max-width: 48ch;
    opacity: 0.78;
  }

  .mm__card-body > :first-child { margin-block-start: 0; }
  .mm__card-body > :last-child { margin-block-end: 0; }

  .mm__price {
    margin: 0;
    text-align: left;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }

  .mm__price-value {
    font-family: var(--font-heading--family, inherit);
    font-size: clamp(40px, 5.2vw, 68px);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .mm__price-note {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .mm__deliverables {
    display: grid;
    grid-template-columns: 1fr;
    gap: 11px;
    margin: 0;
    padding: 24px 0 0;
    list-style: none;
    border-block-start: 1px solid rgb(255 255 255 / 0.14);
  }

  .mm__deliverable {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    font-size: 15px;
    line-height: 1.45;
  }

  .mm__tick {
    flex: 0 0 auto;
    inline-size: 20px;
    block-size: 20px;
    margin-block-start: 1px;
    border-radius: 50%;
    background: var(--mm-accent, #1242fd);
    color: #fff;
    display: grid;
    place-items: center;
  }

  .mm__tick svg { inline-size: 12px; block-size: 12px; }

  .mm__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .mm__btn {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px 14px 28px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1), background 0.28s ease, box-shadow 0.28s ease;
  }

  .mm__btn--primary { background: #fff; color: #111; }
  .mm__btn--primary:hover { transform: translateY(-2px); box-shadow: 0 12px 28px rgb(0 0 0 / 0.28); }

  .mm__btn-arrow {
    inline-size: 32px;
    block-size: 32px;
    border-radius: 50%;
    background: var(--mm-accent, #1242fd);
    color: #fff;
    display: grid;
    place-items: center;
    transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .mm__btn--primary:hover .mm__btn-arrow { transform: translateX(4px); }
  .mm__btn-arrow svg { inline-size: 16px; block-size: 16px; }

  .mm__btn--ghost {
    padding: 14px 26px;
    border: 1px solid rgb(255 255 255 / 0.4);
    color: inherit;
  }

  .mm__btn--ghost:hover { background: rgb(255 255 255 / 0.1); transform: translateY(-2px); }

  /* ---------- 4. steps ---------- */
  .mm__steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--mm-line, #d9d9d4);
    border: 1px solid var(--mm-line, #d9d9d4);
    border-radius: var(--mm-radius, 14px);
    overflow: hidden;
  }

  .mm__step {
    background: var(--mm-bg, #f1f1ef);
    padding: 28px 24px 30px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: background 0.35s ease;
  }

  .mm__step:hover { background: #fff; }

  .mm__step-num {
    font-family: var(--font-heading--family, inherit);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.1em;
    color: var(--mm-accent, #1242fd);
  }

  .mm__step-title {
    font-family: var(--font-heading--family, inherit);
    font-size: 17px;
    font-weight: 900;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--mm-ink, #111);
    margin: 0;
  }

  .mm__step-text { margin: 0; font-size: 14px; line-height: 1.55; }

  /* ---------- 5. closing ---------- */
  .mm__closing {
    border-block-start: 1px solid var(--mm-line, #d9d9d4);
    padding-block-start: clamp(36px, 4vw, 56px);
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
    align-items: flex-start;
  }

  .mm__closing-headline {
    font-family: var(--font-heading--family, inherit);
    font-size: clamp(24px, 3.2vw, 40px);
    font-weight: 900;
    letter-spacing: -0.035em;
    line-height: 1.02;
    text-transform: uppercase;
    color: var(--mm-ink, #111);
    margin: 0;
    flex: 1 1 320px;
    max-width: 18ch;
  }

  .mm__closing-body {
    flex: 1 1 340px;
    font-size: 15px;
    line-height: 1.65;
    max-width: 56ch;
  }

  .mm__closing-body > :first-child { margin-block-start: 0; }
  .mm__closing-body > :last-child { margin-block-end: 0; }

  /* ---------- motion off ---------- */
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity: 1; transform: none; transition: none; }
    .mm__reel { scroll-snap-type: none; }
    .mm__cover-art, .mm__btn, .mm__btn-arrow, .mm__step, .mm__cover-streams, .mm__reel-arrow { transition: none; }
  }

  /* ---------- mobile ---------- */
  @media screen and (max-width: 749px) {
    .mm { padding-block: calc(var(--mm-pad-top, 96px) * 0.65) calc(var(--mm-pad-bottom, 96px) * 0.65); }
    .mm__headline { font-size: var(--mm-h1-mobile, 40px); max-width: none; }
    .mm__stats { grid-template-columns: 1fr; margin-block-start: 2.2rem; }
    .mm__cover, .mm__cover-art { inline-size: 150px; }
    .mm__cover-art { block-size: 150px; }
    /* flanking arrows eat width on a phone; the ones underneath don't */
    .mm__reel-wrap--sides .mm__reel-arrow { display: none; }
    .mm__reel { mask-image: linear-gradient(90deg, #000 92%, transparent); -webkit-mask-image: linear-gradient(90deg, #000 92%, transparent); }
    .mm__price { text-align: left; align-items: flex-start; }
    .mm__card-top { flex-direction: column; }
    .mm__btn { inline-size: 100%; justify-content: space-between; }
    .mm__btn--ghost { justify-content: center; }
    .mm__steps { grid-template-columns: 1fr; }
    .mm__gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .mm__photo--wide { grid-column: span 2; }
    .mm__plans { grid-template-columns: 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mix & Master",
  "tag": "section",
  "class": "mix-master-wrapper section-wrapper",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "1 · Hero"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Eyebrow",
      "default": "MIX & MASTER"
    },
    {
      "type": "text",
      "id": "hero_headline",
      "label": "Headline",
      "default": "Release-ready engineering."
    },

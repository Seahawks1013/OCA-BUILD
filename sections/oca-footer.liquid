{%- comment -%}
  OneClickAudio footer
  Dark footer in the same visual language as the Vocal Presets / Sound Kits pages:
  big uppercase sign-up callout, link columns, socials, and an oversized wordmark.
{%- endcomment -%}

{%- liquid
  assign shop_menu = section.settings.shop_menu
  assign help_menu = section.settings.help_menu
  assign has_social = false
  if section.settings.instagram_url != blank or section.settings.tiktok_url != blank or section.settings.youtube_url != blank or section.settings.x_url != blank or section.settings.spotify_url != blank
    assign has_social = true
  endif
-%}

<footer
  class="ocf"
  style="
    --ocf-bg: {{ section.settings.background_color }};
    --ocf-ink: {{ section.settings.text_color }};
    --ocf-accent: {{ section.settings.accent_color }};
    --ocf-max: {{ section.settings.max_width }}px;
  "
>
  <div class="ocf__glow" aria-hidden="true"></div>

  <div class="ocf__inner">

    {%- comment -%} ---------- sign-up callout ---------- {%- endcomment -%}
    <div class="ocf__cta">
      <div class="ocf__cta-copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ocf__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.headline != blank -%}
          <h2 class="ocf__headline">{{ section.settings.headline }}</h2>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p class="ocf__sub">{{ section.settings.subtext }}</p>
        {%- endif -%}
      </div>

      <div class="ocf__signup">
        {%- form 'customer', id: 'OcfSignup', class: 'ocf__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="ocf__form-msg ocf__form-msg--ok" role="status">{{ section.settings.success_text }}</p>
          {%- else -%}
            <label class="ocf__visually-hidden" for="OcfSignupEmail">Email address</label>
            <div class="ocf__field">
              <input
                id="OcfSignupEmail"
                class="ocf__input"
                type="email"
                name="contact[email]"
                placeholder="{{ section.settings.placeholder | escape }}"
                autocomplete="email"
                autocapitalize="off"
                spellcheck="false"
                required
                {% if form.errors %}aria-invalid="true" aria-describedby="OcfSignupError"{% endif %}
              >
              <button class="ocf__submit" type="submit">
                <span>{{ section.settings.button_label }}</span>
                <span class="ocf__submit-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </button>
            </div>
            {%- if form.errors -%}
              <p id="OcfSignupError" class="ocf__form-msg ocf__form-msg--err" role="alert">
                {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>

    {%- comment -%} ---------- columns ---------- {%- endcomment -%}
    <div class="ocf__grid">
      <div class="ocf__brand">
        <a class="ocf__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
          {%- if settings.logo != blank -%}
            {{ settings.logo | image_url: width: 600 | image_tag: class: 'ocf__logo-img', alt: shop.name, loading: 'lazy' }}
          {%- else -%}
            <span class="ocf__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>
        {%- if section.settings.tagline != blank -%}
          <p class="ocf__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}

        {%- if has_social -%}
          <ul class="ocf__social" role="list">
            {%- if section.settings.instagram_url != blank -%}
              <li><a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"/></svg>
              </a></li>
            {%- endif -%}
            {%- if section.settings.tiktok_url != blank -%}
              <li><a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener" aria-label="TikTok">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.6 3c.4 2.2 1.8 3.7 4 4v3.1c-1.5 0-2.9-.4-4-1.2v6.4c0 3.4-2.5 5.7-5.6 5.7S5.4 18.6 5.4 15.5c0-3.3 2.8-5.8 6.3-5.4v3.2c-1.6-.3-3.1.7-3.1 2.2 0 1.3 1 2.3 2.4 2.3 1.5 0 2.4-1 2.4-2.6V3h3.2z" fill="currentColor"/></svg>
              </a></li>
            {%- endif -%}
            {%- if section.settings.youtube_url != blank -%}
              <li><a href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener" aria-label="YouTube">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.6 7.2c-.2-.9-.9-1.6-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4c-.9.2-1.6.9-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8c.2.9.9 1.6 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4c.9-.2 1.6-.9 1.8-1.8.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8zM10 15V9l5.2 3L10 15z" fill="currentColor"/></svg>
              </a></li>
            {%- endif -%}
            {%- if section.settings.spotify_url != blank -%}
              <li><a href="{{ section.settings.spotify_url }}" target="_blank" rel="noopener" aria-label="Spotify">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="currentColor"/><path d="M7 9.4c3.4-1 7.2-.7 10.2.9M7.6 12.4c2.8-.8 5.9-.5 8.4.8M8.2 15.2c2.2-.6 4.6-.4 6.6.6" fill="none" stroke="var(--ocf-bg)" stroke-width="1.7" stroke-linecap="round"/></svg>
              </a></li>
            {%- endif -%}
            {%- if section.settings.x_url != blank -%}
              <li><a href="{{ section.settings.x_url }}" target="_blank" rel="noopener" aria-label="X">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.8 3h3.1l-6.8 7.8 8 10.2h-6.3l-4.9-6.4L5.3 21H2.2l7.3-8.3L1.8 3h6.4l4.4 5.9L17.8 3zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5z" fill="currentColor"/></svg>
              </a></li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>

      {%- if shop_menu != blank and shop_menu.links.size > 0 -%}
        <nav class="ocf__col" aria-label="{{ section.settings.shop_heading | escape }}">
          <h3 class="ocf__col-title">{{ section.settings.shop_heading }}</h3>
          <ul class="ocf__links" role="list">
            {%- for link in shop_menu.links -%}
              <li><a class="ocf__link" href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      <nav class="ocf__col" aria-label="{{ section.settings.help_heading | escape }}">
        <h3 class="ocf__col-title">{{ section.settings.help_heading }}</h3>
        <ul class="ocf__links" role="list">
          {%- if section.settings.contact_link != blank -%}
            <li><a class="ocf__link" href="{{ section.settings.contact_link }}">Contact</a></li>
          {%- endif -%}
          {%- if help_menu != blank -%}
            {%- for link in help_menu.links -%}
              <li><a class="ocf__link" href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- endif -%}
          {%- if section.settings.show_email and shop.email != blank -%}
            <li><a class="ocf__link ocf__link--email" href="mailto:{{ shop.email }}"><span class="ocf__email-full">{{ shop.email }}</span><span class="ocf__email-short">Email us</span></a></li>
          {%- endif -%}
        </ul>
      </nav>

      <nav class="ocf__col" aria-label="{{ section.settings.legal_heading | escape }}">
        <h3 class="ocf__col-title">{{ section.settings.legal_heading }}</h3>
        <ul class="ocf__links" role="list">
          {%- for policy in shop.policies -%}
            {%- if policy.title == blank -%}{%- continue -%}{%- endif -%}
            <li><a class="ocf__link" href="{{ policy.url }}">{{ policy.title }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    </div>

    {%- comment -%} ---------- bottom bar ---------- {%- endcomment -%}
    <div class="ocf__bar">
      <p class="ocf__copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.bar_text }}</p>
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="ocf__pay" role="list" aria-label="Payment methods">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'ocf__pay-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.wordmark != blank -%}
    <div class="ocf__wordmark" aria-hidden="true">{{ section.settings.wordmark }}</div>
  {%- endif -%}
</footer>

{% stylesheet %}
  .ocf {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--ocf-bg, #0a0e26);
    color: var(--ocf-ink, #fff);
    font-feature-settings: 'kern' 1, 'liga' 1;
  }

  .ocf__glow {
    position: absolute;
    inset: -30% -10% auto auto;
    inline-size: min(900px, 90vw);
    block-size: min(900px, 90vw);
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--ocf-accent, #1242fd) 55%, transparent), transparent);
    filter: blur(40px);
    opacity: 0.55;
    z-index: -1;
    pointer-events: none;
  }

  .ocf__inner {
    max-inline-size: var(--ocf-max, 1160px);
    margin-inline: auto;
    padding: clamp(36px, 5vw, 64px) clamp(18px, 4vw, 40px) 0;
  }

  .ocf__visually-hidden {
    position: absolute !important;
    inline-size: 1px; block-size: 1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
  }

  /* ---------- callout ---------- */
  .ocf__cta {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: end;
    gap: clamp(20px, 4vw, 56px);
    padding-block-end: clamp(28px, 4vw, 44px);
    border-block-end: 1px solid rgb(255 255 255 / 0.12);
  }

  .ocf__eyebrow {
    margin: 0 0 0.7rem;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ocf-accent, #1242fd) 55%, #fff);
  }

  .ocf__headline {
    margin: 0;
    font-family: var(--font-heading--family, inherit);
    font-size: clamp(28px, 3.6vw, 46px);
    font-weight: 900;
    line-height: 0.94;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    color: var(--ocf-ink, #fff);
    text-wrap: balance;
  }

  .ocf__sub {
    margin: 0.7rem 0 0;
    max-width: 46ch;
    font-size: 14px;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.68);
  }

  .ocf__field {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.06);
    border: 1px solid rgb(255 255 255 / 0.16);
    transition: border-color 0.25s ease, background 0.25s ease;
  }

  .ocf__field:focus-within {
    border-color: color-mix(in srgb, var(--ocf-accent, #1242fd) 70%, #fff);
    background: rgb(255 255 255 / 0.09);
  }

  .ocf__input {
    flex: 1 1 auto;
    min-inline-size: 0;
    padding: 9px 8px 9px 16px;
    border: 0;
    background: transparent;
    color: #fff;
    font: inherit;
    font-size: 14px;
    outline: none;
  }

  .ocf__input::placeholder { color: rgb(255 255 255 / 0.45); }

  .ocf__submit {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 7px 7px 16px;
    border: 0;
    border-radius: 999px;
    background: #fff;
    color: #111;
    font: inherit;
    font-size: 14px;
    font-weight: 800;
    cursor: pointer;
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .ocf__submit:hover { transform: translateY(-2px); }
  .ocf__submit:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }

  .ocf__submit-arrow {
    display: inline-grid;
    place-items: center;
    inline-size: 26px;
    block-size: 26px;
    border-radius: 50%;
    background: var(--ocf-accent, #1242fd);
    color: #fff;
  }

  .ocf__submit-arrow svg { inline-size: 15px; block-size: 15px; }

  .ocf__form-msg { margin: 12px 0 0 18px; font-size: 14px; }
  .ocf__form-msg--ok { margin: 0; padding: 16px 20px; border-radius: 16px; background: rgb(255 255 255 / 0.08); font-weight: 700; }
  .ocf__form-msg--err { color: #ff9a9a; }

  /* ---------- columns ---------- */
  .ocf__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px);
    padding-block: clamp(28px, 4vw, 44px);
  }

  .ocf__logo { display: inline-block; }

  .ocf__logo-img {
    display: block;
    block-size: 20px;
    inline-size: auto;
    filter: brightness(0) invert(1);
  }

  .ocf__logo-text { font-weight: 900; font-size: 22px; color: #fff; }

  .ocf__tagline {
    margin: 12px 0 0;
    max-width: 30ch;
    font-size: 13px;
    line-height: 1.55;
    color: rgb(255 255 255 / 0.6);
  }

  .ocf__social {
    display: flex;
    gap: 8px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  .ocf__social a {
    display: grid;
    place-items: center;
    inline-size: 36px;
    block-size: 36px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.18);
    color: #fff;
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .ocf__social a:hover {
    background: var(--ocf-accent, #1242fd);
    border-color: var(--ocf-accent, #1242fd);
    transform: translateY(-2px);
  }

  .ocf__social svg { inline-size: 16px; block-size: 16px; }

  .ocf__col-title {
    margin: 0 0 12px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.45);
  }

  .ocf__links {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ocf__link {
    position: relative;
    display: inline-block;
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease, transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .ocf__link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: -3px;
    block-size: 2px;
    background: var(--ocf-accent, #1242fd);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .ocf__link:hover { transform: translateX(3px); }
  .ocf__link:hover::after { transform: scaleX(1); }
  .ocf__link:focus-visible { outline: 2px solid #fff; outline-offset: 3px; border-radius: 2px; }
  .ocf__link--email { font-weight: 500; color: rgb(255 255 255 / 0.75); }
  .ocf__email-short { display: none; }

  /* ---------- bottom bar ---------- */
  .ocf__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 16px;
    border-block-start: 1px solid rgb(255 255 255 / 0.12);
  }

  .ocf__copy { margin: 0; font-size: 12px; color: rgb(255 255 255 / 0.5); }

  .ocf__pay { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .ocf__pay-icon { display: block; inline-size: 38px; block-size: 24px; }

  /* ---------- wordmark ---------- */
  .ocf__wordmark {
    margin-block-start: 0;
    margin-block-end: -0.1em;
    font-family: var(--font-heading--family, inherit);
    font-size: clamp(40px, 7vw, 132px);
    font-weight: 900;
    line-height: 0.8;
    letter-spacing: -0.06em;
    text-transform: uppercase;
    text-align: center;
    white-space: nowrap;
    color: transparent;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.16), rgb(255 255 255 / 0.02) 85%);
    -webkit-background-clip: text;
    background-clip: text;
    user-select: none;
    pointer-events: none;
  }


  /* ---------- desktop: one compact row (brand · Shop · Help · Legal · sign-up) ---------- */
  @media screen and (min-width: 990px) {
    .ocf__inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) repeat(3, max-content) minmax(300px, 1.15fr);
      column-gap: clamp(32px, 3.6vw, 56px);
      align-items: start;
      padding-block-start: 48px;
    }
    .ocf__grid { display: contents; }
    .ocf__brand, .ocf__col { grid-row: 1; }
    .ocf__cta {
      grid-column: 5;
      grid-row: 1;
      display: block;
      padding: 0;
      border: 0;
    }
    .ocf__eyebrow { margin-block-end: 6px; font-size: 10px; }
    .ocf__headline { font-size: 24px; letter-spacing: -0.025em; }
    .ocf__sub { margin: 6px 0 14px; font-size: 13px; color: rgb(255 255 255 / 0.6); }
    .ocf__bar { grid-column: 1 / -1; grid-row: 2; margin-block-start: 40px; }
  }

  /* ---------- responsive ---------- */
  @media screen and (max-width: 989px) {
    .ocf__cta { grid-template-columns: 1fr; align-items: start; }
    .ocf__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .ocf__brand { grid-column: 1 / -1; }
  }

  @media screen and (max-width: 599px) {
    .ocf__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 16px; }
    .ocf__brand { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; }
    .ocf__tagline { display: none; }
    .ocf__social { margin: 0; }
    .ocf__col:last-child { grid-column: 1 / -1; }
    .ocf__col:last-child .ocf__links { display: flex; flex-wrap: wrap; gap: 6px 16px; }
    .ocf__col:last-child .ocf__link { font-size: 13px; font-weight: 500; color: rgb(255 255 255 / 0.7); }
    .ocf__link--email { font-weight: 600; color: #fff; }
    .ocf__email-full { display: none; }
    .ocf__email-short { display: inline; }
    .ocf__submit span:first-child { display: none; }
    .ocf__submit { padding: 9px; }
    .ocf__bar { flex-direction: column; align-items: flex-start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ocf__submit, .ocf__social a, .ocf__link, .ocf__link::after { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "OneClickAudio footer",
  "tag": "div",
  "class": "oca-footer-wrapper",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "header", "content": "Sign-up callout" },
    { "type": "text", "id": "eyebrow", "label": "Small line above", "default": "Stay in the loop" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Sound pro first." },
    { "type": "text", "id": "subtext", "label": "Text", "default": "New presets, free drops and producer deals. Straight to your inbox, no spam." },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "you@email.com" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign up" },
    { "type": "text", "id": "success_text", "label": "Thank-you message", "default": "You're in. Watch your inbox." },
    { "type": "header", "content": "Brand" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Drag. Drop. Sound Pro. Vocal presets and sound kits for independent artists." },
    { "type": "url", "id": "instagram_url", "label": "Instagram" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok" },
    { "type": "url", "id": "youtube_url", "label": "YouTube" },
    { "type": "url", "id": "spotify_url", "label": "Spotify" },
    { "type": "url", "id": "x_url", "label": "X" },
    { "type": "header", "content": "Columns" },
    { "type": "text", "id": "shop_heading", "label": "Column 1 title", "default": "Shop" },
    { "type": "link_list", "id": "shop_menu", "label": "Column 1 menu", "default": "main-menu" },
    { "type": "text", "id": "help_heading", "label": "Column 2 title", "default": "Help" },
    { "type": "url", "id": "contact_link", "label": "Contact link" },
    { "type": "link_list", "id": "help_menu", "label": "Column 2 menu", "default": "footer" },
    { "type": "checkbox", "id": "show_email", "label": "Show store email", "default": true },
    { "type": "text", "id": "legal_heading", "label": "Column 3 title", "default": "Legal", "info": "Lists your store policies automatically." },
    { "type": "header", "content": "Bottom" },
    { "type": "text", "id": "bar_text", "label": "Text after copyright", "default": "Instant digital delivery." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "text", "id": "wordmark", "label": "Big wordmark", "default": "oneclickaudio", "info": "Oversized faded text at the very bottom. Leave empty to hide." },

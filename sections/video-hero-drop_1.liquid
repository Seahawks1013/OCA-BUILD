
{%- liquid
  assign video_url = section.settings.video_url | default: ''

  # --- Desktop aspect ratio ---
  assign desktop_ratio = section.settings.aspect_ratio
  if desktop_ratio == 'custom'
    assign desktop_ratio = section.settings.custom_ratio_width
      | append: ' / '
      | append: section.settings.custom_ratio_height
  endif

  # --- Mobile aspect ratio (falls back to desktop unless overridden) ---
  assign mobile_ratio = desktop_ratio
  if section.settings.custom_mobile_ratio
    assign mobile_ratio = section.settings.aspect_ratio_mobile
    if mobile_ratio == 'custom'
      assign mobile_ratio = section.settings.custom_ratio_width_mobile
        | append: ' / '
        | append: section.settings.custom_ratio_height_mobile
    endif
  endif

  # --- Screen-height handling (aspect ratio is bypassed) ---
  # 'fullscreen' = 100% of the screen, 'screen' = the adjustable percentage.
  assign section_classes = 'video-hero-drop'
  assign screen_height_desktop = 100
  assign screen_height_mobile = 100

  if desktop_ratio == 'fullscreen' or desktop_ratio == 'screen'
    if desktop_ratio == 'screen'
      assign screen_height_desktop = section.settings.screen_height
    endif
    assign section_classes = section_classes | append: ' video-hero-drop--screen-desktop'
    assign desktop_ratio = '16 / 9'
  endif

  if mobile_ratio == 'fullscreen' or mobile_ratio == 'screen'
    if mobile_ratio == 'screen'
      assign screen_height_mobile = section.settings.screen_height_mobile
    endif
    assign section_classes = section_classes | append: ' video-hero-drop--screen-mobile'
    assign mobile_ratio = '16 / 9'
  endif
-%}

{%- liquid
  # Is there actually a mobile-specific asset to use?
  assign has_mobile_media = false
  if section.settings.custom_mobile_media
    if section.settings.mobile_video != blank
      assign has_mobile_media = true
    elsif section.settings.mobile_video_url != blank
      assign has_mobile_media = true
    elsif section.settings.mobile_fallback_image != blank
      assign has_mobile_media = true
    endif
  endif
-%}

{%- capture desktop_media -%}
  {%- if section.settings.video != blank -%}
    {{
      section.settings.video
      | video_tag:
        autoplay: true,
        loop: true,
        controls: false,
        muted: true,
        playsinline: true,
        class: 'video-hero-drop__video'
    }}
  {%- elsif video_url != blank -%}
    <video class="video-hero-drop__video" autoplay loop muted playsinline src="{{ video_url }}"></video>
  {%- elsif section.settings.fallback_image != blank -%}
    {{
      section.settings.fallback_image
      | image_url: width: 3840
      | image_tag:
        class: 'video-hero-drop__video',
        widths: '832, 1200, 1600, 1920, 2560, 3840',
        sizes: '100vw'
    }}
  {%- else -%}
    <div class="video-hero-drop__placeholder"></div>
  {%- endif -%}
{%- endcapture -%}

{%- capture mobile_media -%}
  {%- if section.settings.mobile_video != blank -%}
    {{
      section.settings.mobile_video
      | video_tag:
        autoplay: true,
        loop: true,
        controls: false,
        muted: true,
        playsinline: true,
        class: 'video-hero-drop__video'
    }}
  {%- elsif section.settings.mobile_video_url != blank -%}
    <video class="video-hero-drop__video" autoplay loop muted playsinline src="{{ section.settings.mobile_video_url }}"></video>
  {%- elsif section.settings.mobile_fallback_image != blank -%}
    {{
      section.settings.mobile_fallback_image
      | image_url: width: 1600
      | image_tag:
        class: 'video-hero-drop__video',
        widths: '416, 600, 800, 1200, 1600',
        sizes: '100vw'
    }}
  {%- endif -%}
{%- endcapture -%}

<div
  id="VideoHeroDrop-{{ section.id }}"
  class="{{ section_classes }}"
  style="
    --vhd-ratio: {{ desktop_ratio }};
    --vhd-ratio-mobile: {{ mobile_ratio }};
    --vhd-screen-h: {{ screen_height_desktop }}svh;
    --vhd-screen-h-mobile: {{ screen_height_mobile }}svh;
    --vhd-min-height: {{ section.settings.min_height }}svh;
    --vhd-overlay-color: {{ section.settings.overlay_color }};
    --vhd-text-color: {{ section.settings.text_color }};
    --vhd-heading-size: {{ section.settings.heading_size }}px;
    --vhd-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --vhd-subheading-size: {{ section.settings.subheading_size }}px;
  "
>
  {%- comment -%}
    Video background.

    Desktop and mobile media each live in a <template>, and a tiny inline
    script mounts exactly one of them. This matters: a plain CSS show/hide
    makes phones download BOTH files, and <source media="..."> is unreliable
    (Chromium fetches both and then plays the desktop one anyway). This way a
    phone only ever downloads the mobile file.
  {%- endcomment -%}
  <div
    class="video-hero-drop__media"
    data-vhd-media
    data-has-mobile="{% if has_mobile_media %}true{% else %}false{% endif %}"
  >
    <template data-vhd-desktop>{{ desktop_media }}</template>
    {%- if has_mobile_media -%}
      <template data-vhd-mobile>{{ mobile_media }}</template>
    {%- endif -%}
    <noscript>{{ desktop_media }}</noscript>
  </div>

  {%- comment -%} Dark Overlay {%- endcomment -%}
  <div class="video-hero-drop__overlay"></div>

  {%- comment -%} Text Content {%- endcomment -%}
  <div class="video-hero-drop__content">
    {%- if section.settings.subheading != blank -%}
      <p class="video-hero-drop__subheading">
        {{ section.settings.subheading }}
      </p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="video-hero-drop__heading">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a
        href="{{ section.settings.button_link | default: '#' }}"
        class="video-hero-drop__button"
        {% if section.settings.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}
      >
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{%- comment -%}
  Inline (not {% javascript %}) on purpose: this runs during HTML parsing, so
  the video is in place before first paint. An external, deferred bundle would
  leave the hero briefly empty.
{%- endcomment -%}
<script>
  (function () {
    function mountHeroMedia(root) {
      var host = root && root.querySelector ? root.querySelector('[data-vhd-media]') : null;
      if (!host || host.dataset.vhdMounted === '1') return;

      var wantsMobile =
        host.dataset.hasMobile === 'true' && window.matchMedia('(max-width: 749px)').matches;

      var template =
        host.querySelector(wantsMobile ? '[data-vhd-mobile]' : '[data-vhd-desktop]') ||
        host.querySelector('[data-vhd-desktop]');

      if (!template) return;

      host.dataset.vhdMounted = '1';
      host.appendChild(template.content.cloneNode(true));

      var video = host.querySelector('video');
      if (video && video.play) {
        var attempt = video.play();
        if (attempt && attempt.catch) attempt.catch(function () {});
      }
    }

    mountHeroMedia(document.getElementById('VideoHeroDrop-{{ section.id }}'));

    // Re-mount when the theme editor re-renders the section
    document.addEventListener('shopify:section:load', function (event) {
      mountHeroMedia(event.target);
    });
  })();
</script>

{% stylesheet %}
  .video-hero-drop {
    position: relative;
    width: 100%;
    aspect-ratio: var(--vhd-ratio, 16 / 9);
    min-height: var(--vhd-min-height, 0px);
    /* Never clip the text: grow past the ratio if the content needs the room. */
    min-height: max(var(--vhd-min-height, 0px), fit-content);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* Screen-height sizing overrides the ratio */
  @media screen and (min-width: 750px) {
    .video-hero-drop--screen-desktop {
      aspect-ratio: auto;
      min-height: var(--vhd-screen-h, 100svh);
    }
  }

  /* Video / Image Background */
  .video-hero-drop__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .video-hero-drop__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  .video-hero-drop__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #1a1a2e, #16213e, #0f3460);
  }

  /* Dark Overlay */
  .video-hero-drop__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--vhd-overlay-color, rgba(0, 0, 0, 0.45));
    pointer-events: none;
  }

  /* Text Content */
  .video-hero-drop__content {
    position: relative;
    z-index: 2;
    text-align: center;
    color: var(--vhd-text-color, #ffffff);
    padding: 2rem;
    max-width: 960px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .video-hero-drop__subheading {
    font-size: var(--vhd-subheading-size, 16px);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin: 0;
    opacity: 0.9;
  }

  .video-hero-drop__heading {
    font-size: var(--vhd-heading-size, 72px);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .video-hero-drop__button {
    display: inline-block;
    margin-top: 1rem;
    padding: 14px 40px;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    color: var(--vhd-text-color, #ffffff);
    border: 2px solid var(--vhd-text-color, #ffffff);
    border-radius: 50px;
    background: transparent;
    transition: background 0.25s ease, color 0.25s ease;
    letter-spacing: 0.05em;
  }

  .video-hero-drop__button:hover {
    background: var(--vhd-text-color, #ffffff);
    color: #000;
  }

  /* Mobile */
  @media screen and (max-width: 749px) {
    .video-hero-drop {
      aspect-ratio: var(--vhd-ratio-mobile, var(--vhd-ratio, 16 / 9));
    }

    .video-hero-drop--screen-mobile {
      aspect-ratio: auto;
      min-height: var(--vhd-screen-h-mobile, 100svh);
    }

    .video-hero-drop__content {
      padding: 1.25rem;
    }

    .video-hero-drop__heading {
      font-size: var(--vhd-heading-size-mobile, 40px);
    }

    .video-hero-drop__subheading {
      font-size: 13px;
    }

    .video-hero-drop__button {
      padding: 12px 32px;
      font-size: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
